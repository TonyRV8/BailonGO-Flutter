# ─────────────────────────────────────────────────────────────
# BailonGO — .gitignore
# Regla: se versiona TODO lo necesario para clonar y correr la app.
# ─────────────────────────────────────────────────────────────

# Flutter / Dart — artefactos de build (se regeneran con `flutter pub get`)
.dart_tool/
.packages
build/
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/
*.log
/coverage/

# NOTA: pubspec.lock SÍ se versiona (es una app, no un paquete).
# Garantiza que todo el equipo compile con las mismas versiones.

# IDE — cada quien genera la suya al abrir el proyecto
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Configuración local de máquina (rutas absolutas del SDK)
android/local.properties
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# Firma de release (NUNCA subir)
**/key.properties
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision

# Credenciales de servidor / admin (NUNCA subir)
*serviceAccount*.json
service-account*.json
*.pem
.env
.env.*

# NOTA: android/app/google-services.json SÍ se versiona.
# Sólo contiene identificadores públicos de cliente Firebase (los mismos que
# ya están en lib/core/config/firebase_options.dart). El acceso a los datos
# lo protegen firestore.rules y storage.rules, no este archivo.

# Videos de prueba duplicados en la raíz. Las copias canónicas que la app
# empaqueta viven en assets/videos y assets/fixtures y SÍ se versionan.
/bad.mov
/good.mov
/ref.mov

# Notas internas y borradores de documentación (no versionar)
/plan_old.txt
/resumen*.txt
/actual.txt
/notas*.txt
/docs/
*.docx
/ESCOM_TT1*.pdf
/TT1_*.pdf
/Evidencias_*.pdf
~$*

# OS
.DS_Store
Thumbs.db

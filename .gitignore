# ─────────────────────────────────────────────────────────────
# BailonGO — .gitignore
# Regla: se versiona TODO lo necesario para clonar y correr la app.
# ─────────────────────────────────────────────────────────────

# Flutter / Dart — artefactos de build (se regeneran con `flutter pub get`)
.dart_tool/
.packages
build/
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
.fvm/
*.log
/coverage/

# NOTA: pubspec.lock SÍ se versiona (es una app, no un paquete).
# Garantiza que todo el equipo compile con las mismas versiones.

# IDE — cada quien genera la suya al abrir el proyecto
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Configuración local de máquina (rutas absolutas del SDK)
android/local.properties
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# Firma de release (NUNCA subir)
**/key.properties
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision

# Credenciales de servidor / admin (NUNCA subir)
*serviceAccount*.json
service-account*.json
*.pem
.env
.env.*

# NOTA: android/app/google-services.json SÍ se versiona.
# Sólo contiene identificadores públicos de cliente Firebase (los mismos que
# ya están en lib/core/config/firebase_options.dart). El acceso a los datos
# lo protegen firestore.rules y storage.rules, no este archivo.

# Videos de prueba duplicados en la raíz. Las copias canónicas que la app
# empaqueta viven en assets/videos y assets/fixtures y SÍ se versionan.
/bad.mov
/good.mov
/ref.mov

# Notas internas y borradores de documentación (no versionar)
/plan_old.txt
/resumen*.txt
/actual.txt
/notas*.txt
/docs/
*.docx
/storage.rules
*.txt
/ESCOM_TT1*.pdf
/TT1_*.pdf
/Evidencias_*.pdf
/BailonGO_TT1_DOCUMENTACIÓN.pdf
~$*

# OS
.DS_Store
Thumbs.db

# ── Material de baile en bruto (grabaciones de la profesora) ─────────────────
# Carpeta fuente completa: tomas originales a 1080x1920 / ~12 Mbps (~440 MB en
# total). NO se versiona: git no puede soltar esos objetos una vez commiteados.
# Las copias canónicas que usa la app son las recomprimidas a 720x1280:
#   Buenos -> assets/videos/<pasoId>.mp4          (SÍ se versionan, ~15 MB)
#   Malos  -> assets/fixtures/<pasoId>_regular.mp4 (no se versionan, ver abajo)
# Conserva esta carpeta en local como copia maestra y respáldala aparte.
/BailonGObailes/

# Tomas "regulares" (4-6/10). Sólo sirven para calibrar el motor: no se
# entregan en el APK y pesan demasiado para versionarlas.
/assets/fixtures/*_regular.mp4

# Landmarks extraídos en PC para calibrar (22 MB, regenerable en ~4 min con
# tool/extract_landmarks.py). No se versiona.
/tool/landmarks.json
/tool/landmarks_revisados.json
/tool/__pycache__/

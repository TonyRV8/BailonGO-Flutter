rules_version = '2';

// Cloud Storage: fotos de perfil (RF-02). Cada usuario escribe solo su
// archivo; lectura para autenticados (el avatar se muestra vía URL de
// descarga). Copiar en Firebase Console -> Storage -> Rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_photos/{uid}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
